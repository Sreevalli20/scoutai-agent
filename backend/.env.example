# ScoutAI Backend Environment Variables
# Copy this file to .env and fill in your actual API keys

# Anakin API Configuration
# Required for production, can be empty for unit tests
ANAKIN_API_KEY=

# Groq API Configuration
# Required for production, can be empty for unit tests
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192

# CORS Configuration
# Comma-separated list of allowed origins for development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Server Configuration
# Optional: Override default host and port
# HOST=0.0.0.0
# PORT=8000

# Environment
ENVIRONMENT=development
